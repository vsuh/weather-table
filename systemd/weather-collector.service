[Unit]
Description=Weather Data Collector
After=network.target bluetooth.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/weather-table
Environment=PATH=/home/ubuntu/weather-table/.venv/bin
ExecStart=/home/ubuntu/weather-table/.venv/bin/python collector/main.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
