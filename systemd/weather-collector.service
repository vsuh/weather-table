[Unit]
Description=Weather Data Collector
After=network.target bluetooth.target bluetooth.service
Wants=bluetooth.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=vsuh
Group=vsuh
WorkingDirectory=/opt/weather-table
Environment=PATH=/opt/weather-table/.venv/bin

# Перед стартом включаем Bluetooth. Префикс "+" запускает команду от root
# (сам сервис работает от vsuh), префикс "-" не даёт ошибке остановить запуск.
ExecStartPre=-+/usr/sbin/rfkill unblock bluetooth
ExecStartPre=-+/usr/bin/bluetoothctl power on

ExecStart=/opt/weather-table/.venv/bin/python collector/main.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
