[Unit]
Description=Weather Data Collector
After=network.target bluetooth.target

[Service]
Type=simple
User=vsuh
Group=vsuh
WorkingDirectory=/opt/weather-table
Environment=PATH=/opt/weather-table/.venv/bin
ExecStart=/opt/weather-table/.venv/bin/python collector/main.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
