[Unit]
Description=Weather Table API Server
After=network.target

[Service]
Type=simple
User=vsuh
Group=vsuh
WorkingDirectory=/opt/weather-table
Environment=PATH=/opt/weather-table/.venv/bin
ExecStart=/opt/weather-table/.venv/bin/python -m uvicorn api.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
